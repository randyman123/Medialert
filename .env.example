PORT=3000
APP_PORT=3000

DB_HOST=localhost
DB_PORT=3307
DB_USER=medialert_user
DB_PASS=medialert_pass
DB_NAME=medialert

JWT_SECRETO=tu_secreto_jwt
JWT_EXPIRA=8h

# Origenes permitidos para el frontend, separados por coma.
# Ejemplo:
# CORS_ORIGINS=https://medialert-demo.vercel.app,https://medialert.pages.dev
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Opcional. Para Render se recomienda usar un disco persistente, por ejemplo:
# STORAGE_BASE_DIR=/var/data/mis-archivos
STORAGE_BASE_DIR=storage/mis-archivos

# Configuracion de recordatorios por WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock

# Twilio WhatsApp
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=

# Meta WhatsApp Cloud API
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=

# Videollamadas de telemedicina
TELEMEDICINA_VIDEO_PROVIDER=mock
TELEMEDICINA_VIDEO_AUTO_CREATE=true

# Daily.co
TELEMEDICINA_VIDEO_DAILY_API_KEY=
TELEMEDICINA_VIDEO_DAILY_DOMAIN=

# AWS S3
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=medialert-archivos-clinicos
